# Copie ce fichier en ".env" sur le serveur (cp .env.example .env) puis remplis-le.
# Ne l'envoie JAMAIS sur GitHub : il contient tes secrets.

# Ton domaine (sans https://). L'app web sera sur APP_DOMAIN, l'API sur API_DOMAIN.
APP_DOMAIN=senetontine.com
API_DOMAIN=api.senetontine.com

# E-mail pour le certificat HTTPS (alertes d'expiration Let's Encrypt).
ACME_EMAIL=ton-email@exemple.com

# Mot de passe de la base : génère-le avec   openssl rand -base64 32
DB_PASSWORD=

# Clés NabooPay (tableau de bord NabooPay > Paramètres > Intégration).
NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=
