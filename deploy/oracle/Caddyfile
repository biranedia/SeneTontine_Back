# HTTPS automatique (Let's Encrypt) pour l'API. Caddy renouvelle le certificat tout seul.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Seuls /api/* et la sonde de santé sont publiés ; le reste du backend reste privé.
	@public path /api/* /actuator/health
	handle @public {
		reverse_proxy api:8080
	}
	handle {
		respond 404
	}
}
